# Copy this file to ".env" and fill in your real values.
# Never commit the real .env to GitHub.

ELEVENLABS_API_KEY=your_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# Optional — override defaults from Program.cs without editing code
CHROME_URL=https://claude.ai/new
SONG_URI=spotify:track:YOUR_TRACK_ID

# Optional — enables voice song search ("play <song>"). Get these free at
# https://developer.spotify.com/dashboard (create an app, no approval needed).
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Optional — path to your God's Eye View clone, if it's not at C:\gods-eye-view
GEV_PATH=C:\gods-eye-view
